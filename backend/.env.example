NODE_ENV=development
PORT=4000

# Local Postgres connection. connection_limit is set explicitly so the API
# process and the worker process (two separate Node processes, each holding
# its own Prisma connection pool) don't exhaust Postgres max_connections.
DATABASE_URL="postgresql://webhook_relay:CHANGE_ME@localhost:5432/webhook_relay_dev?schema=public&connection_limit=10"
TEST_DATABASE_URL="postgresql://webhook_relay:CHANGE_ME@localhost:5432/webhook_relay_test?schema=public&connection_limit=5"

REDIS_URL="redis://localhost:6379"

JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d

# Set to true once the dashboard is served over HTTPS.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
