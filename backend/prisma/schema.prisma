generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  free
  pro
}

enum DeliveryStatus {
  pending
  success
  failed
  retrying
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  applications Application[]

  @@map("users")
}

model Application {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  signingSecret String  @map("signing_secret")

  // Ingestion API key: only a lookup prefix + hash are stored, never the raw key.
  apiKeyPrefix String   @unique @map("api_key_prefix")
  apiKeyHash   String   @map("api_key_hash")

  planTier     PlanTier @default(free) @map("plan_tier")
  createdAt    DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoints Endpoint[]
  events    Event[]

  @@index([userId])
  @@map("applications")
}

model Endpoint {
  id                   String   @id @default(uuid())
  applicationId        String   @map("application_id")
  url                  String
  description          String?
  // Free-form, tenant-defined event type strings; "*" means "all events".
  subscribedEventTypes String[] @map("subscribed_event_types")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@index([applicationId])
  @@map("endpoints")
}

model Event {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  eventType     String   @map("event_type")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@index([applicationId, createdAt])
  @@index([applicationId, eventType])
  @@map("events")
}

model Delivery {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  endpointId    String         @map("endpoint_id")
  status        DeliveryStatus @default(pending)
  attemptCount  Int            @default(0) @map("attempt_count")
  lastAttemptedAt DateTime?    @map("last_attempted_at")
  nextRetryAt   DateTime?      @map("next_retry_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  // When this delivery was created via manual replay, points back to the
  // delivery it replayed. Null for the original, automatic fan-out delivery.
  replayedFromDeliveryId String?   @map("replayed_from_delivery_id")
  replayedFrom           Delivery? @relation("DeliveryReplays", fields: [replayedFromDeliveryId], references: [id])
  replays                Delivery[] @relation("DeliveryReplays")

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  attempts DeliveryAttempt[]

  // There is intentionally no DB-level uniqueness constraint on
  // (eventId, endpointId): Postgres could enforce "one original delivery per
  // pair, unlimited replays" with a partial unique index (UNIQUE ... WHERE
  // replayed_from_delivery_id IS NULL), but Prisma's schema DSL cannot
  // express partial indexes, and hand-maintaining one outside the schema
  // would fight `prisma migrate dev` on every future migration. Instead,
  // ingestionService creates exactly one Delivery per matching endpoint
  // inside the single ingest transaction, so duplicates never arise from
  // fan-out; this index just supports the replay/lookup query pattern.
  @@index([eventId, endpointId])
  @@index([endpointId])
  @@index([status, nextRetryAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id                   String   @id @default(uuid())
  deliveryId           String   @map("delivery_id")
  attemptNumber        Int      @map("attempt_number")
  statusCode           Int?     @map("status_code")
  responseBodyTruncated String? @map("response_body_truncated")
  latencyMs            Int?     @map("latency_ms")
  attemptedAt          DateTime @default(now()) @map("attempted_at")
  succeeded            Boolean

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  // The core idempotency guard: a given attempt number for a given delivery
  // can only ever be recorded once, even if a queue-level retry re-delivers
  // the same job.
  @@unique([deliveryId, attemptNumber])
  @@map("delivery_attempts")
}
